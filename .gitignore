# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# data files (large)
# data/history.json  # Kubernetes 테스트를 위해 주석 처리

# python
# python/models/  # Kubernetes 테스트를 위해 주석 처리
python/training_data_with_weather.json
python/__pycache__/
# *.pkl  # 모델 파일 포함

# 보안/산출물 (커밋 금지)
.env
.env.local
python/models/*.pkl
*.xlsx
